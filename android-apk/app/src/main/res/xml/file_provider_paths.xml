<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider paths para o EUNAMAN PCM.
    Permite ao app compartilhar o arquivo de foto com a câmera do Android
    de forma segura (sem URI de arquivo direto, que é bloqueado no Android 7+).
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fotos tiradas pela câmera ficam em getExternalFilesDir(PICTURES) -->
    <external-files-path
        name="eunaman_photos"
        path="Pictures/" />

    <!-- Acesso para a pasta Downloads/ e outros caminhos externos (necessário para o FileProvider no Android 9 e inferior) -->
    <external-path
        name="external_storage"
        path="." />
</paths>
