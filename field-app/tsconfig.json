{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/utils/supabase/client": ["./src/lib/supabase-client.ts"],
      "@/components/auth-context": ["./src/compat/auth-context.tsx"],
      "@/components/offline-provider": ["./src/compat/offline-provider.tsx"],
      "@/components/premium-loader": ["./src/compat/premium-loader.tsx"],
      "@/src/repositories/PneusRepository": ["./src/repositories/PneusRepository.ts"],
      "@/src/repositories/EquipamentoRepository": ["./src/repositories/EquipamentoRepository.ts"],
      "@/src/services/CaptacaoService": ["./src/services/CaptacaoService.ts"],
      "@/src/services/BacklogService": ["./src/services/BacklogService.ts"],
      "@/src/services/PreventivaService": ["./src/services/PreventivaService.ts"],
      "@/src/services/HorimetroService": ["./src/services/HorimetroService.ts"],
      "@/src/services/OSService": ["./src/services/OSService.ts"],
      "@/src/repositories/OSRepository": ["./src/repositories/OSRepository.ts"],
      "@/app/checklist-mecanicos/checklistConfig": ["../app/checklist-mecanicos/checklistConfig.ts"],
      "@/lib/*": ["../lib/*"],
      "@/components/*": ["../components/*"],
      "@/hooks/*": ["../hooks/*"],
      "@/src/models/*": ["../src/models/*"],
      "@/src/utils/*": ["../src/utils/*"],
      "@/utils/*": ["../utils/*"],
      "@/*": ["../*"]
    }
  },
  "include": ["src"]
}
