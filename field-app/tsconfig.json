{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/utils/supabase/client": ["./src/lib/supabase-client.ts"],
      "@/lib/*": ["../lib/*"],
      "@/components/*": ["../components/*"],
      "@/utils/*": ["../utils/*"],
      "@/*": ["../*"]
    }
  },
  "include": ["src"]
}
